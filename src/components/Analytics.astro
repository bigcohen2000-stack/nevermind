<script is:inline>
  (() => {
    window.nmTrackEvent = (name, params = {}) => {
      if (!name) return;
      try {
        window.dispatchEvent(new CustomEvent("nm-analytics-event", { detail: { name, params } }));
      } catch {
      }
    };
  })();
</script>

<script>
  import type { Metric } from 'web-vitals';

  // Web Vitals tracking
  const reportWebVitals = (metric: Metric) => {
    // Send to analytics
    (window as any).nmTrackEvent?.('web_vitals', {
      name: metric.name,
      value: metric.value,
      rating: metric.rating,
      delta: metric.delta,
      id: metric.id
    });

    // Log to console in development
    if (import.meta.env.DEV) {
      console.log('Web Vital:', metric);
    }
  };

  // Dynamic import to avoid bundle bloat
  import('web-vitals').then(({ onCLS, onFCP, onLCP, onTTFB, onINP }) => {
    onCLS(reportWebVitals);
    onFCP(reportWebVitals);
    onLCP(reportWebVitals);
    onTTFB(reportWebVitals);
    if (onINP) onINP(reportWebVitals);
  }).catch(err => {
    console.warn('Web Vitals tracking failed to load:', err);
  });

  // User interaction tracking
  let interactionCount = 0;
  const trackInteraction = () => {
    interactionCount++;
    if (interactionCount === 1) {
      (window as any).nmTrackEvent?.('first_interaction');
    }
  };

  document.addEventListener('click', trackInteraction, { once: true });
  document.addEventListener('keydown', trackInteraction, { once: true });
  document.addEventListener('touchstart', trackInteraction, { once: true });

  // Theme preference tracking
  const trackThemeChange = (theme: string) => {
    (window as any).nmTrackEvent?.('theme_change', { theme });
  };

  // Listen for theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        trackThemeChange(theme);
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme']
  });

  // Search tracking
  const trackSearch = (query: string, results: number) => {
    (window as any).nmTrackEvent?.('search', {
      query: query.substring(0, 100), // Limit length
      results_count: results,
      has_results: results > 0
    });
  };

  // Listen for search events
  window.addEventListener('nm-search-performed', (event: any) => {
    const { query, results } = event.detail || {};
    if (query !== undefined && results !== undefined) {
      trackSearch(query, results);
    }
  });
</script>
