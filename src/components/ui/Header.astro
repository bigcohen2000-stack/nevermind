---
const { logoPath, wordmarkHe, intentNavItems } = Astro.props;
---

<header class="fixed inset-x-0 z-50 transition-all duration-300" style={{ top: 'var(--nm-nav-top, 1.5rem)' }}>
  <nav class="mx-auto max-w-7xl px-6" aria-label="ניווט ראשי">
    <div class="flex items-center justify-between py-6">
      <a href="/" class="flex items-center gap-4 group">
        <img
          src={logoPath}
          alt="NeverMind"
          width="42"
          height="42"
          class="h-10 w-10 object-contain transition-transform group-hover:scale-105"
          loading="eager"
          fetchpriority="high"
        />
        <span class="text-xl font-medium tracking-tight text-[#1A1A1A]">{wordmarkHe}</span>
      </a>

      <ul class="hidden md:flex items-center gap-10" role="list">
        {intentNavItems.map((item) => (
          <li role="none">
            <a
              href={item.href}
              class="text-[15px] font-medium text-[#1A1A1A]/60 transition-colors hover:text-[#1A1A1A] focus-visible:text-[#D42B2B]"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-4">
        <button
          id="search-trigger"
          type="button"
          aria-label="חיפוש"
          class="p-2 text-[#1A1A1A]/60 hover:text-[#1A1A1A] transition-colors"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </button>
        <a
          href="/premium-access/"
          class="hidden sm:inline-flex items-center rounded-full bg-[#1A1A1A] px-5 py-2 text-sm font-medium text-[#FAFAF8] transition-all hover:bg-[#D42B2B] hover:scale-105"
        >
          כניסה
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const trigger = document.getElementById('search-trigger');
    trigger?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search'));
    });
  });
</script>
