---
interface Props {
  wordmarkHe: string;
  logoPath: string;
  footerLinkColumns: { title: string; links: { href: string; label: string }[] }[];
  disclaimerLong: string;
}

const { wordmarkHe, logoPath, footerLinkColumns, disclaimerLong } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#FAFAF8] border-t border-[#1A1A1A]/5 pt-20 pb-12 px-6">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-20">
      <div class="space-y-6">
        <a href="/" class="flex items-center gap-3">
          <img src={logoPath} alt="NeverMind" width="32" height="32" class="h-8 w-8" />
          <span class="text-lg font-semibold text-[#1A1A1A]">{wordmarkHe}</span>
        </a>
        <p class="text-sm leading-relaxed text-[#1A1A1A]/50 max-w-xs">
          הזהות האמיתית שלך מתחילה איפה שהשם שלך נגמר. שיתוף מוזמן עם ציון מקור.
        </p>
      </div>

      {footerLinkColumns.map((col) => (
        <div class="space-y-6">
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#1A1A1A]/30">{col.title}</h3>
          <ul class="space-y-4">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm font-medium text-[#1A1A1A]/60 hover:text-[#D42B2B] transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-[#1A1A1A]/5 gap-6">
      <p class="text-xs text-[#1A1A1A]/40">
        © {currentYear} {wordmarkHe}. כל הזכויות שמורות.
      </p>
      <div class="flex items-center gap-8">
        <a href="/privacy" class="text-xs text-[#1A1A1A]/40 hover:text-[#1A1A1A]">פרטיות</a>
        <a href="/terms" class="text-xs text-[#1A1A1A]/40 hover:text-[#1A1A1A]">תנאים</a>
        <a href="/accessibility" class="text-xs text-[#1A1A1A]/40 hover:text-[#1A1A1A]">נגישות</a>
      </div>
    </div>

    {disclaimerLong && (
      <p class="mt-12 text-[10px] leading-relaxed text-[#1A1A1A]/30 text-center max-w-4xl mx-auto">
        {disclaimerLong}
      </p>
    )}
  </div>
</footer>
