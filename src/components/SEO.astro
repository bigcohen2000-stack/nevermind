---
import appConfig from "../config/appConfig.json";
import siteSettings from "../config/siteSettings.json";
import { jsonLdForInlineScript } from "../lib/json-ld-inline";
import {
  buildSiteBreadcrumbTrail,
  breadcrumbTrailToJsonLd,
} from "../lib/site-breadcrumbs";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: any;
  image?: string;
  noIndex?: boolean;
  faqItems?: { question: string; answer: string }[];
  articleBody?: string;
}

const {
  title,
  description,
  frontmatter,
  image,
  noIndex = false,
  faqItems = [],
  articleBody,
} = Astro.props;

const brandCfg = (siteSettings as any).brand ?? {};
const siteWordmark = brandCfg.wordmarkHe || "השם לא משנה";
const siteTitle = `${siteWordmark} | NeverMind`;
const siteDescription = "הבית של NeverMind: שקט נפשי, בהירות, חשיבה צלולה והפרדה בין עובדה, פירוש ותגובה.";
const siteUrl = appConfig.site.url;
const siteUrlSlash = siteUrl.endsWith("/") ? siteUrl : `${siteUrl}/`;

const pageTitle = title ? (title.includes(siteWordmark) ? title : `${title} | ${siteWordmark}`) : siteTitle;
const pageDescription = (description ?? frontmatter?.description ?? siteDescription).slice(0, 155);
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const logoPath = brandCfg.logoPath || "/images/logo.svg";
const logoAbsolute = new URL(logoPath.replace(/^\//, ""), siteUrlSlash).toString();

const ogImage = image || frontmatter?.image || logoPath;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : new URL(ogImage.replace(/^\//, ""), siteUrlSlash).toString();

// Organization Schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteTitle,
  url: siteUrl,
  logo: logoAbsolute,
  image: logoAbsolute,
  description: siteDescription,
  inLanguage: "he-IL",
};

// Website Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  url: siteUrl,
  inLanguage: "he-IL",
  potentialAction: {
    "@type": "SearchAction",
    target: new URL("search/?q={search_term_string}", siteUrlSlash).toString(),
    "query-input": "required name=search_term_string",
  },
};

// Breadcrumb Schema
const breadcrumbCrumbs = buildSiteBreadcrumbTrail(Astro.url.pathname, { currentPageTitle: title || frontmatter?.title });
const breadcrumbJsonLdItems = breadcrumbTrailToJsonLd(breadcrumbCrumbs, pageUrl, siteUrlSlash);

const breadcrumbSchema = breadcrumbCrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbJsonLdItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.item,
  })),
} : null;

// FAQ Schema
const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
} : null;

// Article Schema
const articleSchema = frontmatter?.pubDate ? {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title || title,
  description: pageDescription,
  image: ogImageAbsolute,
  datePublished: new Date(frontmatter.pubDate).toISOString(),
  dateModified: new Date(frontmatter.updatedDate || frontmatter.pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: frontmatter.author || "יקיר כהן",
  },
  publisher: {
    "@type": "Organization",
    name: siteTitle,
    logo: {
      "@type": "ImageObject",
      url: logoAbsolute,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  isAccessibleForFree: !frontmatter.isPremium,
  articleBody: articleBody || undefined,
} : null;

const coreStructuredData = [organizationSchema, websiteSchema, breadcrumbSchema, faqSchema, articleSchema].filter(Boolean);
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
<link rel="canonical" href={pageUrl} />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:url" content={pageUrl} />
<meta property="og:type" content={frontmatter?.pubDate ? "article" : "website"} />
<meta name="twitter:card" content="summary_large_image" />

<script is:inline type="application/ld+json" set:html={jsonLdForInlineScript(coreStructuredData)}></script>
