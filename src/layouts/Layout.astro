---
import "@fontsource-variable/assistant/wght.css";
import "@fontsource/heebo/index.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import SEO from "../components/SEO.astro";
import SearchModal from "../components/SearchModal.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Analytics from "../components/Analytics.astro";
import appConfig from "../config/appConfig.json";
import siteSettings from "../config/siteSettings.json";
import { disclaimerLong } from "../lib/services";

const {
  title,
  description,
  frontmatter,
  image,
  noIndex = false,
  faqItems,
} = Astro.props;

const brandCfg = (siteSettings as any).brand ?? {};
const siteWordmark = brandCfg.wordmarkHe || "השם לא משנה";
const logoPath = brandCfg.logoPath || "/images/logo.svg";

const intentNavItems = [
  { href: "/blog/", label: "ארכיון" },
  { href: "/studio/", label: "סטודיו" },
  { href: "/glossary/", label: "הגדרות" },
  { href: "/about/", label: "אודות" },
];

const footerLinkColumns = [
  {
    title: "תוכן",
    links: [
      { href: "/library/", label: "ספרייה" },
      { href: "/articles/", label: "מאמרים" },
      { href: "/forbidden-library/", label: "הספרייה האסורה" },
    ],
  },
  {
    title: "שירות",
    links: [
      { href: "/personal-consultation/", label: "שיחה אישית" },
      { href: "/services/", label: "מחירון" },
      { href: "/contact/", label: "קשר" },
    ],
  },
];
---
<!doctype html>
<html lang="he" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      frontmatter={frontmatter}
      image={image}
      noIndex={noIndex}
      faqItems={faqItems}
    />
    <meta name="theme-color" content="#FAFAF8" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body class="antialiased text-[#1A1A1A] bg-[#FAFAF8]">
    <Header
      logoPath={logoPath}
      wordmarkHe={siteWordmark}
      intentNavItems={intentNavItems}
    />

    <main id="main-content" class="mx-auto max-w-5xl px-6 min-h-screen">
      <div id="weightless-wrapper" class="weightless-enter">
        <slot />
      </div>
    </main>

    <Footer
      wordmarkHe={siteWordmark}
      logoPath={logoPath}
      footerLinkColumns={footerLinkColumns}
      disclaimerLong={disclaimerLong}
    />

    <SearchModal />
    <WhatsAppButton phone={appConfig.contact.whatsAppNumber} />
    <Analytics />

    <script>
      function initWeightless() {
        const wrapper = document.getElementById('weightless-wrapper');
        if (wrapper) {
          wrapper.classList.remove('weightless-enter');
          void wrapper.offsetWidth;
          wrapper.classList.add('weightless-enter-active');
        }
      }
      document.addEventListener("astro:page-load", initWeightless);
    </script>
  </body>
</html>
