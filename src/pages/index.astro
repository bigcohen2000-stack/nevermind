---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import MethodTextBlock from "../components/methodology/MethodTextBlock.astro";
import { buildWhatsAppHref } from "../lib/services";

const allArticles = await getCollection("articles", ({ data }) => data.draft !== true);
const sortedArticles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sampleArticles = sortedArticles.slice(0, 3);

const waHref = buildWhatsAppHref(
  "היי, הגעתי מדף הבית. רוצה להבין איך מצטרפים ל-NeverMind."
);

const values = [
  { title: "בהירות", body: "לראות מה באמת מפעיל אותך, בלי הדרמה." },
  { title: "הפרדה", body: "בין מה שקרה לבין מה שסיפרת לעצמך על זה." },
  { title: "שקט", body: "היכולת לבחור תגובה במקום לפעול אוטומטית." }
];
---

<Layout title="הבנה לפני תגובה">
  <section class="py-20 lg:py-32">
    <div class="max-w-3xl">
      <h1 class="text-[clamp(2.5rem,5vw,4.5rem)] font-semibold leading-[1.1] mb-8 tracking-tight">
        לראות את המציאות <span class="text-[#D42B2B]">כמו שהיא.</span>
      </h1>
      <p class="text-xl md:text-2xl text-[#1A1A1A]/60 leading-relaxed mb-12 max-w-2xl">
        NeverMind היא שיטה שמפרידה בין עובדה, פירוש ותגובה. מקום לבדיקה שקטה, חקירה עצמית וחזרה לשכל הישר.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/about" class="px-8 py-4 bg-[#1A1A1A] text-[#FAFAF8] rounded-full font-medium hover:bg-[#D42B2B] transition-all hover:scale-105">
          איך זה עובד
        </a>
        <a href="/articles" class="px-8 py-4 border border-[#1A1A1A]/10 rounded-full font-medium hover:bg-[#1A1A1A]/5 transition-all">
          לקריאה בארכיון
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 border-t border-[#1A1A1A]/5">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {values.map(v => (
        <div class="space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-widest text-[#D42B2B]">{v.title}</h2>
          <p class="text-lg font-medium leading-relaxed">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-24 bg-[#1A1A1A] rounded-[3rem] px-8 md:px-16 text-[#FAFAF8]">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-semibold mb-6">מנוי NeverMind</h2>
      <p class="text-lg text-[#FAFAF8]/60 mb-10 leading-relaxed">
        גישה לסרטונים מלאים, תכנים שלא מפורסמים בפומבי, והקבוצה השקטה. מקום למי שרוצה להעמיק באמת.
      </p>
      <a href="/me/unlock/" class="inline-flex px-8 py-4 bg-[#FAFAF8] text-[#1A1A1A] rounded-full font-bold hover:bg-[#D42B2B] hover:text-[#FAFAF8] transition-all">
        הצטרפות למועדון
      </a>
    </div>
  </section>

  <section class="py-32">
    <h2 class="text-xs font-bold uppercase tracking-widest text-[#1A1A1A]/30 mb-12">מאמרים אחרונים</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {sampleArticles.map(article => (
        <a href={`/articles/${article.slug}/`} class="group block space-y-4">
          <div class="aspect-video bg-[#1A1A1A]/5 rounded-2xl overflow-hidden">
             {article.data.image && (
               <img src={article.data.image} alt="" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
             )}
          </div>
          <h3 class="text-xl font-semibold group-hover:text-[#D42B2B] transition-colors">{article.data.title}</h3>
          <p class="text-sm text-[#1A1A1A]/50 line-clamp-2">{article.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
